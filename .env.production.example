# ==========================================
# Cravery Platform Production Environment
# ==========================================

# Database Configuration (PostgreSQL)
DB_NAME=food_delivery
DB_USERNAME=postgres
DB_PASSWORD=change_this_to_a_strong_password_in_production

# JWT Security
# REQUIRED: Generate a unique 256-bit secret: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_GENERATED_SECRET_openssl_rand_hex_32
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=2592000000

# Super Admin Account Credentials (REQUIRED: set a strong password)
ADMIN_EMAIL=admin@cravery.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
SESSION_COOKIE_SECURE=true

# Public Domain / URLs
# For single-domain VPS (via Nginx reverse proxy):
FRONTEND_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_WS_URL=/ws

# For separate subdomain setups (e.g. Vercel frontend + Railway backend):
# FRONTEND_URL=https://cravery.vercel.app
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api
# NEXT_PUBLIC_WS_URL=https://api.yourdomain.com/ws

# Database Migrations (Flyway)
FLYWAY_ENABLED=true

# Cloud Object Storage (S3 / Cloudflare R2 / AWS S3)
STORAGE_TYPE=local
# For AWS S3 or Cloudflare R2:
# STORAGE_TYPE=s3
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=cravery-uploads
# S3_ACCESS_KEY=your_access_key
# S3_SECRET_KEY=your_secret_key
# S3_REGION=auto
# S3_PUBLIC_URL=https://cdn.yourdomain.com
