# ==========================================
# Cravery Platform Production Environment
# ==========================================

# Database Configuration (PostgreSQL)
DB_NAME=food_delivery
DB_USERNAME=postgres
DB_PASSWORD=change_this_to_a_strong_password_in_production

# JWT Security
# Generate a new 256-bit secret using: openssl rand -hex 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION=604800000
JWT_REFRESH_EXPIRATION=2592000000

# Super Admin Account Credentials
ADMIN_EMAIL=admin@cravery.com
ADMIN_PASSWORD=change_this_admin_password_123

# Public Domain / URLs
# For single-domain VPS (via Nginx reverse proxy):
FRONTEND_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_WS_URL=/ws

# For separate subdomain setups (e.g. Vercel frontend + Railway backend):
# FRONTEND_URL=https://cravery.vercel.app
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api
# NEXT_PUBLIC_WS_URL=https://api.yourdomain.com/ws
