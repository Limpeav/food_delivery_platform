# =========================================================
# Cravery Frontend — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# NEVER commit the real .env.local file to version control.
# =========================================================

# ---------------------------------------------------------
# Backend API URL
# Local dev: http://localhost:8080/api
# Render (production backend): https://your-backend.onrender.com/api
# ---------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_WS_URL=http://localhost:8080/ws

# ---------------------------------------------------------
# Google OAuth
# Get Client ID from: https://console.cloud.google.com/
# Restrict authorized origins to your domain in production.
# ---------------------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# ---------------------------------------------------------
# Social Media Profiles (leave blank to hide in footer)
# ---------------------------------------------------------
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_TELEGRAM_URL=

# ---------------------------------------------------------
# Mobile App Store URLs (leave blank during App Store review)
# ---------------------------------------------------------
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_GOOGLE_PLAY_URL=
