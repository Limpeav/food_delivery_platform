DB_URL=jdbc:postgresql://localhost:5432/food_delivery
DB_USERNAME=your_postgres_username
DB_PASSWORD=your_postgres_password

JWT_SECRET=your_256_bit_hex_jwt_secret_here
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

REDIS_HOST=localhost
REDIS_PORT=6379

FRONTEND_URL=http://localhost:3000

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password

# ==========================================
# Bakong KHQR Online Payment Configuration
# ==========================================
# Put your Bakong Open API Token here (obtain from National Bank of Cambodia / Bakong)
BAKONG_API_TOKEN=your_bakong_payment_token_here
# Your merchant Bakong Account ID (e.g., your_phone@bakong or merchant_id@bakong)
BAKONG_ACCOUNT_ID=merchant@bakong
# Business / Store Name to display on KHQR
BAKONG_MERCHANT_NAME=Cravery Food Delivery
# City of your business
BAKONG_MERCHANT_CITY=Phnom Penh
# Bakong Open API URL (Production: https://api-bakong.nbc.gov.kh/v1)
BAKONG_API_URL=https://api-bakong.nbc.gov.kh/v1
