# =========================================================
# Cravery Backend — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.
# =========================================================

# ---------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/food_delivery
DB_USERNAME=your_postgres_username
DB_PASSWORD=your_postgres_password

# ---------------------------------------------------------
# JWT Security
# REQUIRED in production — no default fallback.
# Generate: openssl rand -hex 32
# ---------------------------------------------------------
JWT_SECRET=your_256_bit_hex_jwt_secret_here
JWT_ACCESS_EXPIRATION=900000       # 15 minutes (recommended)
JWT_REFRESH_EXPIRATION=2592000000  # 30 days

# ---------------------------------------------------------
# Admin Account (REQUIRED — no default fallback in production)
# ---------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_strong_admin_password

# ---------------------------------------------------------
# Session Cookie
# Set to false for local HTTP dev; true for production HTTPS
# ---------------------------------------------------------
SESSION_COOKIE_SECURE=true

# ---------------------------------------------------------
# Frontend URL (used for CORS)
# ---------------------------------------------------------
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------
# Redis (optional locally — rate limiter falls back to in-memory)
# ---------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

# ---------------------------------------------------------
# Schema Migration
# Set DDL_AUTO=validate in production; update for local dev.
# ---------------------------------------------------------
DDL_AUTO=update
FLYWAY_ENABLED=false

# ---------------------------------------------------------
# Swagger / OpenAPI docs
# Set SWAGGER_ENABLED=true for local dev only.
# ---------------------------------------------------------
SWAGGER_ENABLED=false

# ---------------------------------------------------------
# File Storage
# STORAGE_TYPE=local  → saves to local /uploads directory
# STORAGE_TYPE=s3     → uses S3-compatible object storage
# ---------------------------------------------------------
STORAGE_TYPE=local
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=cravery-uploads
# S3_ACCESS_KEY=your_access_key
# S3_SECRET_KEY=your_secret_key
# S3_REGION=auto
# S3_PUBLIC_URL=https://cdn.yourdomain.com

# ---------------------------------------------------------
# Bakong KHQR Online Payment (National Bank of Cambodia)
# Obtain your token from: https://api-bakong.nbc.gov.kh
# ---------------------------------------------------------
BAKONG_API_TOKEN=your_bakong_payment_token_here
BAKONG_ACCOUNT_ID=merchant@bakong
BAKONG_MERCHANT_NAME=Cravery Food Delivery
BAKONG_MERCHANT_CITY=Phnom Penh
BAKONG_API_URL=https://api-bakong.nbc.gov.kh/v1
