# =====================================================
# Cravery Platform — LOCAL DEVELOPMENT Environment
# Copy this file to .env and fill in values.
# NEVER use these values in production.
# =====================================================

# Database (PostgreSQL — local)
DB_URL=jdbc:postgresql://localhost:5432/food_delivery
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT — use any 64-char hex string for local dev
# Generate: openssl rand -hex 32
JWT_SECRET=4d6576656c6f706d656e744c6f63616c4465764b65793132333435363738393031
JWT_ACCESS_EXPIRATION=900000      # 15 minutes
JWT_REFRESH_EXPIRATION=2592000000 # 30 days

# Admin credentials (local only)
ADMIN_EMAIL=admin@localhost.dev
ADMIN_PASSWORD=LocalAdminPass123!

# Session cookie — set false for local HTTP
SESSION_COOKIE_SECURE=false

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Redis (optional for local — rate limiter falls back to in-memory if absent)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false
